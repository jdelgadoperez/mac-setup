    "superpowers@claude-plugins-official": true,
    "deep-plan@piercelamb-plugins": false,
    "deep-implement@piercelamb-plugins": false,
    "deep-project@piercelamb-plugins": false,
    "obsidian@obsidian-skills": false
  },
  "extraKnownMarketplaces": {
    "piercelamb-plugins": {
      "source": {
        "source": "github",
        "repo": "piercelamb/deep-project"
      }
    }
  },
